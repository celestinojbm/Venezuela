# Copia este archivo a .env.local y rellena con los datos de TU proyecto Supabase.
# Los encuentras en: Supabase > Project Settings > API.

# URL del proyecto (ej. https://abcdxyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon / publishable). Es segura para el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
